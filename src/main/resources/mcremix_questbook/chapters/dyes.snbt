			y: 3.5d
		}
		{
			dependencies: [
				"452A4DAE3CE278D9"
				"11220AE969A46307"
			]
			description: [
				"Aniline, hydrochloric acid, sodium nitrite and ice give a diazo salt, and diazo salts are fussy. Unless ice or snow touches whatever holds one, or it stands somewhere cold enough to snow, it breaks down. Heat ruins it outright."
				""
				"Goggles tell you when it's warming up."
			]
			id: "2B3105C1E2D06B94"
			rewards: [ ]
			subtitle: "Diazo salts spoil warm"
			tasks: [
				{
					id: "636839BB825929FA"
					item: "mcremix:diazo_salt_bucket"
					type: "item"
				}
			]
			title: "Keep It on Ice"
			x: 3.5d
			y: 1.75d
		}
		{
			dependencies: [
				"6B61D77A597EB929"
				"2B3105C1E2D06B94"
			]
			description: [
				"Maroon comes from naphthylamine's diazo salt with naphthol, and naphthol needs sulfuric acid. Yellow, orange and red come from diazo salts too, so you'll get plenty of practice."
			]
			id: "5DA870321EF0BC9A"
