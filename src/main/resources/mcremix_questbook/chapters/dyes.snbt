			y: 3.5d
		}
		{
			dependencies: [
				"452A4DAE3CE278D9"
				"11220AE969A46307"
			]
			description: [
				"Aniline, hydrochloric acid, sodium nitrite and ice mixed cold give a diazo salt. It breaks down unless ice or snow touches what holds it, or it stands where it is cold enough to snow, and heat ruins it at once."
				""
				"Goggles say when it is warming."
			]
			id: "2B3105C1E2D06B94"
			rewards: [ ]
			subtitle: "Diazo salts spoil warm"
			tasks: [
				{
					id: "636839BB825929FA"
