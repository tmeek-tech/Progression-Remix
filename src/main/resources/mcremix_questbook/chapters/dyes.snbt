		{
			dependencies: [
				"695A658C30C5B030"
				"109BD4CCCD1F5D59"
			]
			description: [
				"Sour gas is fuel gas carrying hydrogen sulfide, which poisons and flashes. Clean it and the sulfur comes out as a bonus."
				""
				"Small scale: pipe sour gas through a vat of red mud with no mixer, then air the foul mud in an open basin, where it drops sulfur and turns red again. Big scale: wash the gas with soda ash solution in a stirred vat, boil the foul soda for hydrogen sulfide, and burn that over alumina in a Steel Furnace into molten sulfur."
				""
				"&7JEI: the Airing tab.&r"
			]
			id: "21D1DCB0DD850FAC"
			rewards: [ ]
			subtitle: "Cleaned out of sour gas"
			tasks: [
				{
					id: "21A5D0ECAFF9CBD6"
					item: "mcremix:sulfur"
					type: "item"
				}
			]
			title: "Sulfur"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: [
				"21D1DCB0DD850FAC"
				"754D20403EEE0165"
			]
			description: [
				"Burn sulfur in a Furnace for sulfur dioxide, and platinum gauze in a &6Hot&r Steel Furnace turns that into sulfur trioxide. Stir it into water in a vat for sulfuric acid, but half fogs off as acid mist unless there's acid in the vat already."
				""
				"Mixed with nitric acid, it nitrates four times as fast."
			]
			id: "6B61D77A597EB929"
			rewards: [ ]
			subtitle: "Sulfur, burnt twice"
			tasks: [
				{
					id: "67A4661495A6D726"
					item: "mcremix:sulfuric_acid_bucket"
					type: "item"
				}
			]
			title: "Sulfuric Acid"
			x: 1.75d
			y: 0.0d
		}
		{
			dependencies: [
				"64207D5B90DBDEF5"
				"670869AA09CABEE6"
			]
			description: [
				"Nitrate light oil into nitrobenzene, then cook that with iron and vinegar into aniline. All basin work; JEI has each step."
			]
			id: "452A4DAE3CE278D9"
			rewards: [ ]
			shape: "hexagon"
			size: 1.5d
			subtitle: "The root of the dyes"
			tasks: [
				{
					id: "4AF9FFA7DED2C3FB"
