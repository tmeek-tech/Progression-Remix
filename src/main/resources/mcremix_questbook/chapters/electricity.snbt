					type: "item"
				}
			]
			title: "A Generator"
			x: 3.5d
			y: 0.0d
		}
		{
			dependencies: [
				"319C7C5E0FF2477D"
			]
			description: [
				"A generator gives one voltage and every device wants another. A transformer steps it up or down."
				""
				"Your next two devices pull opposite ways: the Electrolyser wants a few volts, the Spark Plug about a thousand."
			]
			id: "4B4A1C9CC8E643DD"
			rewards: [ ]
			subtitle: "Every device wants its own voltage"
			tasks: [
				{
					id: "56C9AB622170575F"
