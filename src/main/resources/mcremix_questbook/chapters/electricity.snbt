		}
		{
			dependencies: [
				"4B4A1C9CC8E643DD"
				"670869AA09CABEE6"
			]
			description: [
				"An Electrolyser goes on the side of a basin or vat and splits what's inside. Fit a Carbon Electrode as its anode (+) first, then its cathode."
				""
				"It behaves like a real cell. Below about 4 V almost nothing flows; past that the current shoots up, so a generator wired straight across will cook it. Step the voltage down or wire several in series. Wired backwards, nothing flows."
				""
				"The anode burns away with the power through it, so driving it gently costs less carbon per batch."
				""
				"&7Ponder: the Electrolyser. JEI: the Electrolysis tab.&r"
			]
			id: "6BD37C7E20889D52"
			rewards: [ ]
			shape: "hexagon"
			size: 1.5d
			subtitle: "Volts to start, amps to work"
