		{
			dependencies: [
				"29CC8F5AB0429C0C"
				"77A54992179DB0AA"
			]
			description: [
				"Power Grid adds real circuits: generators, wire, transformers and devices that care about volts and amps. Its own Ponder scenes explain its parts better than this book could."
				""
				"Here its parts are made as real ones are. Wire is drawn from an ingot on a Coil Winder, resistors are carbon, magnets are steel and insulators are glass. Its boards and switches take Bakelite, and the boards are etched in ferric chloride."
				""
				"&7JEI: the Coiling tab. Ponder: the Coil Winder.&r"
			]
			id: "79D3C636DD73D69C"
			rewards: [ ]
			subtitle: "Real circuits, volts and amps"
			tasks: [
				{
					id: "39A5044982D833FD"
