				"6BD37C7E20889D52"
				"41213510650AA21C"
				"764E14D4DF0D32B5"
			]
			description: [
				"Split salt water for chlorine, hydrogen and caustic soda. On a basin the gases escape, and chlorine rolls out as a low yellow-green cloud that hurts anything breathing and kills the plants under it. A vat keeps both gases, ready to pipe away."
				""
				"Iron stirred with chlorine and water in a vat makes ferric chloride, which etches Power Grid's circuit boards."
			]
			id: "5EEDEEC2867C3143"
			rewards: [ ]
			subtitle: "Splitting the sea"
