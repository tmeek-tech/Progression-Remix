					type: "item"
				}
			]
			title: "Create: Power Grid"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: [
				"79D3C636DD73D69C"
			]
			description: [
				"Power Grid's coils come off the Coil Winder too: copper wire into a Copper Coil, iron wire round a brick into a Resistive Coil. The faster it turns, the faster it winds. Once you have aluminium, it rolls capacitors as well."
				""
				"It comes in andesite and every metal from copper to titanium, each held to its metal's top speed."
			]
			id: "6AEF9F7DC91405D5"
			rewards: [ ]
			subtitle: "Wound, not crafted"
			tasks: [
				{
					id: "2EAADC0E0B5F895A"
					item: "powergrid:copper_coil"
					type: "item"
				}
			]
			title: "Coils"
			x: 1.75d
			y: 0.0d
		}
		{
			dependencies: [
				"6AEF9F7DC91405D5"
				"36D4E952BA3CE9EC"
			]
			description: [
				"Power Grid's generator is copper coils strung on shafts round rotors and a commutator, and it has to be excited before it gives anything."
				""
				"Its rotor and commutator come together on Mechanical Crafters, which come only in brass."
				""
				"&7Ponder: the generator parts show how to build and start one.&r"
			]
			id: "319C7C5E0FF2477D"
			rewards: [ ]
			subtitle: "Rotation into current"
			tasks: [
