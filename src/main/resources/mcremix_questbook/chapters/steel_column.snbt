			]
			description: [
				"Steel Column Sections join like Create's tanks, up to three across and sixteen high, each block layer a section. Heat under the column boils its feed: each block under it at the mixture's heat adds more, and hotter adds more again."
				""
				"Feed goes in at the bottom, the residue stays there, and each cut condenses in its own section above, in boiling order."
				""
				"&7Ponder: the column section.&r"
			]
			id: "0CEBDB8A282691E9"
			rewards: [ ]
			subtitle: "Split nonstop"
			tasks: [
				{
					id: "2DD71CA539244965"
					item: "mcremix:steel_column_section"
					type: "item"
				}
			]
			title: "Column Sections"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: [
				"0CEBDB8A282691E9"
			]
			description: [
				"A Steel Condenser beside the bottom section takes the vapour from the top one. No condenser, no column. Water, cold water or coolant through its jacket sets how much it condenses, each better than the last."
			]
			id: "5CD85503C7FA27AB"
			rewards: [ ]
			subtitle: "Without one, nothing moves"
			tasks: [
				{
					id: "67EA7965A66C8443"
					item: "mcremix:steel_condenser"
					type: "item"
				}
			]
			title: "The Steel Condenser"
			x: 1.75d
			y: 0.0d
		}
		{
			dependencies: [
				"5CD85503C7FA27AB"
			]
			description: [
				"A pipe on a section's side draws that section's cut. Leave one undrawn and it fills its section and stalls the whole column."
				""
				"Each mixture needs a section for every cut, with empty sections between close ones. Cuts a short column has no room for escape over the top."
				""
				"&7JEI: the Distilling tab gives the sections each mixture needs.&r"
			]
			icon: "mcremix:steel_fluid_pipe"
			id: "7B195200D9D3485B"
			rewards: [ ]
			subtitle: "A cut nobody draws holds everything up"
			tasks: [
				{
					id: "3A95DD6950665E4C"
					title: "Got it"
					type: "checkmark"
				}
			]
			title: "Draw Every Cut"
			x: 3.5d
			y: 0.0d
		}
		{
			dependencies: [
				"7B195200D9D3485B"
			]
			description: [
				"Pipe some of the top cut back into the top section and it stands in for the empty sections close cuts need, at the cost of pace. It makes no room for a cut the column is simply too short for."
			]
			icon: "create:mechanical_pump"
