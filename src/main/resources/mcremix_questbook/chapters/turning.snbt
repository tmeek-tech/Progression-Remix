	quests: [
		{
			dependencies: [
				"690A67A6D21199B1"
			]
			description: [
				"Create's own shafts, cogs, gearboxes and machines are the andesite tier. They never weather and their shafts take any load, but their supports top out at 128 RPM."
				""
				"Slow, sturdy and maintenance-free: the workhorse for heavy machines all game."
			]
			id: "541D0DC718F4FF4B"
			rewards: [ ]
			subtitle: "Create's own tier, steady and slow"
			tasks: [
				{
					id: "4486CF6DB0698A53"
					item: "create:andesite_alloy"
					type: "item"
				}
			]
			title: "Andesite Alloy"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: [
				"541D0DC718F4FF4B"
			]
			description: [
				"Bread, cake and cookies no longer take whole wheat. Grind it in a Millstone, then knead the flour with a water bottle into dough for the campfire. No bucket needed."
				""
				"A Millstone grinds gravel into flint every time, too: spare tools on tap."
			]
			icon: "create:millstone"
			id: "080518A2B24609EC"
			rewards: [ ]
			subtitle: "Wheat has to be ground first"
			tasks: [
				{
					id: "3054B1BCCB20F3CD"
					item: "create:wheat_flour"
					type: "item"
				}
				{
					id: "11A1F98F9B1604A1"
					item: "minecraft:bread"
					type: "item"
				}
			]
			title: "Bread from the Mill"
			x: 0.0d
			y: -1.75d
		}
		{
			dependencies: [
				"541D0DC718F4FF4B"
			]
			description: [
				"Shafts and cogs don't float any more. Each needs a support: a machine, gearbox, clutch, gearshift, chain drive, casing, or a bracket bolted to something solid. Water wheels, windmills and engines drive but hold nothing."
				""
				"A support holds the parts in line with it as far as their material reaches through the bare parts between, like scaffolding from a post: two blocks for wood and brass, four for andesite, copper and iron, six for steel and up. Out of reach, a part won't go on. Lose its support and it drops."
				""
				"&7Ponder: any shaft, bracket or casing.&r"
			]
			id: "629C0AF66AEA3D00"
			rewards: [ ]
			subtitle: "Every part turns in a support"
			tasks: [
				{
					id: "17E6F1B412B0AFFE"
					item: "create:shaft"
					type: "item"
				}
			]
			title: "Shafts Need Holding"
			x: 1.75d
			y: 0.0d
		}
		{
			dependencies: [
				"629C0AF66AEA3D00"
				"3AC9A7994C4F9DC0"
			]
			description: [
				"Engineer's Goggles show what a placed block is up to: each part's material, what holds it and its limits, a Furnace's heat and fuel, what a machine is waiting for."
				""
				"Their lenses sit in gold sheet, and sheets come only off a press, so goggles wait for iron."
			]
			id: "48EF2BB3E8E92849"
			rewards: [ ]
			subtitle: "See what a block is doing"
			tasks: [
				{
					id: "54288B7E7E69C060"
					item: "create:goggles"
					type: "item"
				}
			]
			title: "Engineer's Goggles"
			x: 1.75d
			y: -1.75d
		}
		{
			dependencies: [
				"629C0AF66AEA3D00"
			]
			description: [
				"Every material has two limits. Stability is how fast its supports can turn. Strength is how much load its shafts and cogs can carry. A part turns as fast as its supports allow, whatever it's made of."
				""
				"Spin a support past its Stability and it grinds for a few seconds, then drops. Pull more stress through a shaft or cog than its Strength and it wobbles, then snaps. Speed never breaks shafts, and load never breaks supports."
				""
				"Tooltips show both as a word and a bar. Goggles give the numbers."
			]
			icon: "create:stressometer"
			id: "3296CE900D1C9370"
			rewards: [ ]
			subtitle: "Speed breaks supports, load breaks shafts"
			tasks: [
				{
					id: "621F22D461AC08AE"
					title: "Got it"
					type: "checkmark"
				}
			]
			title: "Stability and Strength"
			x: 3.5d
			y: 0.0d
		}
		{
			dependencies: [
				"629C0AF66AEA3D00"
			]
			description: [
				"All eleven woods make parts, for next to nothing. They're also the weakest: supports stop at 64 RPM, and the shafts carry less load than anything else."
				""
				"That makes a wooden shaft a fuse. Put one between an engine and a risky machine, and when the machine gets greedy, the wood snaps first."
				""
				"Crimson and warped parts don't burn."
			]
			id: "0BBD389261D0567C"
			optional: true
			rewards: [ ]
			subtitle: "The cheapest parts give way first"
			tasks: [
				{
					icon: "mcremix:oak_shaft"
					id: "3B852AEACAF79693"
					observe_type: 1
					timer: 10L
					title: "Look at a wooden shaft"
					to_observe: "#mcremix:wooden_shafts"
					type: "observation"
				}
			]
			title: "Wood Is the Fuse"
			x: 3.5d
			y: -1.75d
		}
		{
			dependencies: [
				"3296CE900D1C9370"
			]
			description: [
				"Copper supports spin to 256 RPM, twice andesite, but copper shafts and cogs only carry light loads. It's your early road to full speed."
				""
				"Copper weathers within a day, anywhere, and each stage adds a little friction at its supports. Honeycomb waxes it and an axe scrapes it, same as copper blocks."
				""
				"Copper gearboxes, clutches, gearshifts and chain drives are built on Create's copper casing."
			]
			id: "2D5A296BEAA4D578"
			rewards: [ ]
			subtitle: "Full speed, light duty"
			tasks: [
				{
					id: "218168076A2D4D86"
					item: "mcremix:copper_shaft"
					type: "item"
				}
			]
			title: "Copper Parts"
			x: 5.25d
			y: 0.0d
		}
		{
			dependencies: [
				"2D5A296BEAA4D578"
				"4718C7B7C98B7081"
			]
			description: [
				"Copper and iron weather fast, and each block stops at a stage of its own, weathered or fully weathered. Within a day a build gets a lived-in patchwork instead of one flat green."
				""
				"Iron only rusts while wet: rained on, waterlogged or beside water. Dry iron under rustier iron rusts too, so rust runs down a wall. Indoor machines stay clean."
				""
				"Honeycomb seals a block as it is. Scrape it back a stage with an axe and it weathers back to the same stage."
			]
			id: "060ABCEC2D22B788"
			optional: true
			rewards: [ ]
			subtitle: "Fast, and never quite all the way"
			tasks: [
				{
					id: "2E7BA13AA358CDF3"
					item: "minecraft:honeycomb"
					type: "item"
				}
			]
			title: "Weathering"
			x: 7.0d
			y: -1.75d
		}
		{
			dependencies: [
				"2D5A296BEAA4D578"
				"5CF0F2FE999D2187"
				"3AC9A7994C4F9DC0"
			]
			description: [
				"A basin on a Furnace is heated by the fuel burning inside. &cSearing&r heats it like a fed Blaze Burner, enough for brass; &eWarm&r or &6Hot&r only warms it. Heat from under the Furnace passes up as it is, so a soul campfire beneath only warms the basin."
				""
				"Superheated recipes still want a Blaze Burner on Blaze Cake, later Power Grid's basin heater run hot enough, or a Steel Furnace burning &bBlazing&r."
			]
			id: "36D4E952BA3CE9EC"
			rewards: [ ]
			subtitle: "A heated basin, no blazes needed"
			tasks: [
				{
					id: "502A8E24B52D373D"
					item: "create:brass_ingot"
					type: "item"
				}
			]
			title: "Brass"
			x: 7.0d
			y: 0.0d
		}
		{
			dependencies: [
				"36D4E952BA3CE9EC"
			]
			description: [
				"Brass parts are fine clockwork: polished, pretty and delicate. Their supports stop at 96 RPM and their shafts carry little more than wood's. Brass already has some powerful machines, so its parts don't get to be strong too."
				""
				"Brass never tarnishes. It has no clutch, gearshift or chain gearshift, and the Mechanical Crafter comes only in brass."
			]
			id: "15A0CEE9BF75BD3A"
			rewards: [ ]
			subtitle: "Delicate and fancy"
			tasks: [
				{
					id: "5906A2B49E2162C7"
					item: "mcremix:brass_cogwheel"
					type: "item"
				}
			]
			title: "Clockwork Brass"
			x: 8.75d
			y: 0.0d
		}
		{
			dependencies: [
				"2D5A296BEAA4D578"
			]
			description: [
				"Create's press, mixer, millstone, fan, saw, drill, deployer and arm also come in copper, iron, steel, aluminium and titanium: the same machine in a new casing, held to its metal's top speed."
				""
				"Use a casing on a placed machine to change its metal, up or down. It keeps its facing and settings, and the old casing pops out."
				""
				"&7Ponder: any machine shows the materials scene.&r"
			]
			id: "20B01B5CDC744C67"
			rewards: [ ]
			subtitle: "Swap the casing, swap the tier"
			tasks: [
				{
					id: "122EAF728124AE6A"
					item: "create:copper_casing"
					type: "item"
				}
			]
			title: "Machines in Every Metal"
			x: 7.0d
			y: 1.75d
		}
		{
			dependencies: [
				"541D0DC718F4FF4B"
				"6C06A8D2FE2265D4"
			]
			description: [
				"A turning Bellows blows into whatever its nozzle faces. A Furnace there, or one standing on a fire there, burns a level hotter, up to &cSearing&r. It won't reach &bBlazing&r or light a cold Furnace, and fuel it fans burns twice as fast."
				""
				"So cheap heat goes further: a fanned Furnace on a campfire is &6Hot&r for free, and on lava &cSearing&r. Aimed at a lit campfire, it cooks food twice as fast."
			]
			id: "404A1BD175B2514C"
			rewards: [ ]
			subtitle: "One level hotter"
			tasks: [
				{
					id: "1F63B27233C2ED57"
					item: "mcremix:bellows"
					type: "item"
				}
			]
			title: "The Bellows"
			x: 1.75d
			y: 1.75d
		}
		{
			dependencies: [
				"541D0DC718F4FF4B"
				"5CF0F2FE999D2187"
				"3AC9A7994C4F9DC0"
			]
			description: [
				"A boiler on a Furnace is heated by the fuel burning inside, like a Blaze Burner. &cSearing&r boils it; &eWarm&r or &6Hot&r only keeps it simmering. Heat from under the Furnace passes up as it is, so a soul campfire beneath only simmers it."
				""
				"So steam power arrives with Coal Coke, no Nether trip needed."
				""
				"Brass, iron and steel have steam engines of their own, each only for tanks of its own metal. Create's engine stays on Create's copper tanks."
			]
			id: "5C2C3A2E77FAA0F8"
			rewards: [ ]
			subtitle: "A Furnace under a boiler"
			tasks: [
				{
					id: "394D0CCD3CCC42DC"
					item: "create:steam_engine"
					type: "item"
				}
			]
			title: "Steam from Fire"
			x: 0.0d
			y: 3.5d
		}
	]
	subtitle: [
		"Create's kinetics, now with consequences"
	]
	title: "Turning"
}
