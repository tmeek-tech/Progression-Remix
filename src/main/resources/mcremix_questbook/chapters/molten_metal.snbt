					type: "item"
				}
			]
			title: "The Crucible"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: [
				"57E4D8BA15816733"
				"3AC9A7994C4F9DC0"
			]
			description: [
				"Turn the crucible's shaft to tip it. It pours whatever rises over the lip onto what's in front: a Sand Mold on a depot or belt, a tank, another crucible, or the floor, where it spills and sets as rough metal. Aim carefully."
				""
				"A press in a basin rams sand round an ingot or block to make a mold. A full mold sets in two seconds and the casting breaks out."
				""
				"&7JEI: the Casting tab. Ponder: the crucible.&r"
			]
			id: "6D7CDDADA949BC04"
			rewards: [ ]
			subtitle: "Tip it into sand"
			tasks: [
				{
					id: "0C0ACD1A42A449BE"
					item: "mcremix:sand_ingot_mold"
					type: "item"
				}
			]
			title: "Pouring"
			x: 1.75d
			y: 0.0d
		}
		{
			dependencies: [
				"6D7CDDADA949BC04"
			]
			description: [
				"Twenty-seven crucibles in a 3x3x3 cube join into one big crucible. Heat all nine columns and it melts and pours nine times as fast. Tipping it takes real muscle."
			]
			id: "212B25E798689E47"
			optional: true
			rewards: [ ]
			subtitle: "Twenty-seven as one"
			tasks: [
