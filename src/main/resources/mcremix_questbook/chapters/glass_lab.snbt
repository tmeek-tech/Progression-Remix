			]
			description: [
				"Lab glass is eight pieces, each on an iron retort stand. Each takes heat from what's under it, like a basin, up to &6Hot&r. Give it &cSearing&r and it cracks."
				""
				"Hot glass also cracks in rain or beside water, so give your lab a roof. Cracked glass hisses, then shatters five seconds later, spilling everything."
			]
			id: "674C069C050D3746"
			rewards: [ ]
			subtitle: "Glassware on retort stands"
			tasks: [
				{
					id: "061F41B748F4E622"
