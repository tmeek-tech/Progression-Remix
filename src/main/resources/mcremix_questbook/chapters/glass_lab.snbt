		}
		{
			dependencies: [
				"674C069C050D3746"
			]
			description: [
				"A still is a round flask over heat, a still head with a thermometer, a coil condenser on its arm and a cow receiver under the drip, with glass column pieces between flask and head when a mixture needs them."
				""
				"A bucket comes over cut by cut, lightest first, each into its own flask, and the leftovers stay behind. The condenser needs water running through it, and cuts that boil close together need column pieces to come over at full pace."
				""
				"&7JEI: the Distilling tab. Ponder: the still head.&r"
			]
			id: "3120A738668C125F"
			rewards: [ ]
			subtitle: "A bucket at a time, cut by cut"
			tasks: [
				{
					id: "1659F024E6A6D5FF"
					item: "mcremix:still_head"
					type: "item"
				}
				{
					id: "7464A33F8A03C02A"
