				"3120A738668C125F"
				"227161A851D43479"
			]
			description: [
				"Wood spirit distils at &eWarm&r into acetone and methanol, leaving vinegar. The two boil only 9 °C apart, so a bare still is slow to split them. Column pieces fix that."
				""
				"Vinegar strips copper's patina, the way acid strips rust."
			]
			id: "0066D6427AE070DE"
			rewards: [ ]
