					type: "item"
				}
			]
			title: "The Still"
			x: 3.5d
			y: 0.0d
		}
		{
			dependencies: [
				"3120A738668C125F"
				"670861ACF270D86D"
			]
			description: [
				"Coal tar distils at &6Hot&r into light oil, carbolic oil and creosote, with pitch left in the flask."
				""
				"Nothing goes to waste. Pitch binds electrodes and briquettes, creosote soaks timber and burns as fuel, carbolic oil hides phenol and naphthalene, and light oil is fuel now and the start of the dyes much later."
			]
			id: "670869AA09CABEE6"
			rewards: [ ]
			subtitle: "Light oil, carbolic oil, creosote and pitch"
			tasks: [
				{
					id: "7B2C5FBBD7EEE786"
					item: "mcremix:pitch_bucket"
					type: "item"
				}
			]
			title: "Splitting Coal Tar"
			x: 5.25d
			y: -1.75d
		}
		{
