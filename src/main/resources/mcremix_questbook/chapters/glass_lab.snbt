				"3120A738668C125F"
			]
			description: [
				"Sugar in water ferments by itself into wash: in a basin kept cool with nothing working it, a batch at a time, or in a vat, a batch for every bucket it holds. The still distils wash at &eWarm&r into ethanol."
				""
				"Ethanol is fuel for the Steel Furnace and the start of ethylene."
				""
				"&7JEI: the Fermenting tab.&r"
			]
			id: "2A3F16D2B751D16F"
			rewards: [ ]
			subtitle: "Sugar ferments, the still does the rest"
