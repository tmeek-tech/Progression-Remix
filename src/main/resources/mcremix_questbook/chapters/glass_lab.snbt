				"3120A738668C125F"
			]
			description: [
				"Sugar in water ferments into wash by itself: in a cool basin with nothing working it, a batch at a time, or in a vat, a batch for every bucket it holds. Distil the wash at &eWarm&r for ethanol."
				""
				"Ethanol fuels the Steel Furnace and starts you on ethylene."
				""
				"&7JEI: the Fermenting tab.&r"
			]
			id: "2A3F16D2B751D16F"
			rewards: [ ]
