				"670861ACF270D86D"
			]
			description: [
				"Coal tar distils at &6Hot&r into light oil, carbolic oil and creosote, leaving pitch in the flask."
				""
				"Each has a job: pitch binds electrodes and briquettes, creosote soaks timber and burns as fuel, carbolic oil holds phenol and naphthalene, and light oil is fuel and, much later, the start of the dyes."
			]
			id: "670869AA09CABEE6"
			rewards: [ ]
			subtitle: "Light oil, carbolic oil, creosote and pitch"
			tasks: [
				{
					id: "7B2C5FBBD7EEE786"
					item: "mcremix:pitch_bucket"
					type: "item"
				}
			]
			title: "Splitting Coal Tar"
