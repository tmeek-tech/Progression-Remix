				"541D0DC718F4FF4B"
			]
			description: [
				"The press costs a block of iron, so it waits for a steady supply. It strikes blooms, presses ingots into sheets, and later it's the only thing that beats blister steel into steel."
			]
			id: "3AC9A7994C4F9DC0"
			rewards: [ ]
