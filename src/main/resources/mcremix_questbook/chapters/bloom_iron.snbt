			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: [
				"21A22298535A522F"
			]
			description: [
				"An iron anvil takes a lot of iron and a press a whole block, so your first blooms meet a Stone Anvil. Four strikes a bloom."
				""
				"It cracks as you work and crumbles after about fifteen blooms. No menu, no repairs: it's a rock you hit things on."
			]
			id: "2B464E5EC7982C1A"
			rewards: [ ]
			subtitle: "Strike before you have iron"
			tasks: [
				{
					id: "4D9A4ACE8330BD46"
					item: "mcremix:stone_anvil"
					type: "item"
				}
			]
			title: "A Stone Anvil"
			x: 1.75d
			y: 0.0d
		}
		{
			dependencies: [
				"2B464E5EC7982C1A"
			]
			description: [
				"Each bloom gives an ingot, and half the time a lump of slag. An iron anvil lasts about a hundred blooms, and a Mechanical Press takes the hammer out of your hands for good."
				""
				"Create's crushing and washing still work too: cheaper, but leaner."
			]
			id: "4718C7B7C98B7081"
			rewards: [ ]
			shape: "hexagon"
			size: 1.5d
			subtitle: "An ingot, and sometimes slag"
			tasks: [
				{
					id: "19E42716D5F205D7"
					item: "minecraft:iron_ingot"
					type: "item"
				}
			]
			title: "Iron"
			x: 3.5d
			y: 0.0d
		}
		{
			dependencies: [
				"4718C7B7C98B7081"
			]
			description: [
				"Don't bin it. Slag fertilises like bone meal, and washing it with an Encased Fan gives back iron nuggets and gravel. Later, a Power Grid electromagnet pulls more iron out of it."
			]
			id: "5F042604C274D9E9"
			optional: true
			rewards: [ ]
			subtitle: "Waste worth keeping"
