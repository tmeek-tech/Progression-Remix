			y: 0.0d
		}
		{
			dependencies: [
				"3AC9A7994C4F9DC0"
				"2D5A296BEAA4D578"
			]
			description: [
				"Iron supports spin to 256 RPM like copper's, but iron shafts and cogs take any load. The price: iron supports are a little heavier to turn, even clean."
				""
				"Iron rusts only where it gets wet, each stage adding friction. Iron Casing, made from iron sheet, is the base for iron gearboxes, clutches, gearshifts, chain drives and machines."
			]
			id: "48B70BB7018FC73B"
			rewards: [ ]
			subtitle: "Full speed, any load"
			tasks: [
				{
					id: "5C38543EECF289ED"
					item: "mcremix:iron_casing"
					type: "item"
				}
			]
			title: "Iron Parts"
			x: 5.25d
			y: 1.75d
		}
		{
			dependencies: [
				"4718C7B7C98B7081"
				"541D0DC718F4FF4B"
			]
			description: [
				"Drills and saws come with iron bits or an iron blade, cutting what an iron pickaxe or axe would. Use other bits or blades on a placed one to swap them in."
				""
				"Stone is cheap and light. Gold cuts twice as fast for half the stress, but balks at iron, copper and lapis ore, and a golden blade won't cut stone. Only diamond bits get through obsidian and ancient debris. A drill that can't cut a block skates over it, throwing sparks."
			]
			id: "2A6F4DF807C3BE25"
			rewards: [ ]
			subtitle: "The body sets the speed, the bits what it cuts"
			tasks: [
				{
					id: "0CF5F383B0EC02C0"
					item: "create:mechanical_drill"
					type: "item"
				}
			]
			title: "Bits and Blades"
			x: 3.5d
