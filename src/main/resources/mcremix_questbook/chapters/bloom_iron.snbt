			]
			description: [
				"Iron ore no longer smelts into ingots. Fire bog iron, hematite, magnetite or raw iron at &cSearing&r for a glowing Iron Bloom: spongy iron full of slag that has to be beaten out."
				""
				"&7JEI: the Furnace and Striking Blooms tabs.&r"
			]
			id: "21A22298535A522F"
