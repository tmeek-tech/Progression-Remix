			y: 0.0d
		}
		{
			dependencies: [
				"19CD54A7B8257823"
			]
			description: [
				"To a hose pulley, any pocket is endless, however small. The catch: crude comes up at a slow, fixed rate, however fast the pump turns."
				""
				"&7Ponder: the hose pulley.&r"
			]
			id: "7F744C8C0F462AB7"
