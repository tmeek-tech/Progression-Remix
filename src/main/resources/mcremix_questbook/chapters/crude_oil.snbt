			]
			description: [
				"Crude oil hides in sealed pockets deep underground, between y -40 and -16, under every biome. A skin of stone keeps them off caves and water, so the only way to find one is to dig."
				""
				"Spilt crude creeps out slowly, clings like cobweb and burns."
			]
			id: "19CD54A7B8257823"
			rewards: [ ]
			subtitle: "Found only by digging"
			tasks: [
				{
					id: "4F438B64F9651331"
