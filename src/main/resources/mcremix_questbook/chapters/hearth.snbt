					type: "item"
				}
			]
			title: "Coal Coke"
			x: 7.0d
			y: 0.0d
		}
		{
			dependencies: [
				"35D075A91FFA3F0D"
			]
			description: [
				"Bring a Furnace to &cSearing&r: Coal Coke or blaze rods in the firebox, or soul fire, a soul campfire or a fed Blaze Burner underneath."
				""
				"&cSearing&r is where iron, steel and brass begin. Engineer's Goggles on a Furnace show its exact heat, its fuel and what each slot is waiting for, and a comparator reads its heat."
			]
			id: "5CF0F2FE999D2187"
