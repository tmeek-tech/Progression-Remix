			y: -1.75d
		}
		{
			dependencies: [
				"39E181355BA6BAE4"
			]
			description: [
				"The furnace recipe now makes the Furnace, and it has no menu. Click things to fire into the upper chamber and fuel into the firebox, then watch them glow on the grate."
				""
				"Hoppers and funnels work it too: things to fire in the top, fuel in the sides, results out the bottom. It won't take food."
				""
				"&7Ponder: the Furnace.&r"
			]
			id: "6C06A8D2FE2265D4"
			rewards: [ ]
			subtitle: "No menu, and a cut-open front"
			tasks: [
				{
					id: "29AA74CA6B016190"
					item: "mcremix:kiln"
					type: "item"
				}
			]
			title: "The Furnace"
			x: 3.5d
			y: 0.0d
		}
		{
			dependencies: [
				"6C06A8D2FE2265D4"
			]
			description: [
				"Fuel doesn't light itself. Flint and steel or a fire charge does, by hand or from a Deployer."
				""
				"Flint and steel takes iron, which comes later, so go hunting for your first lighter. Ruined portal chests can hold flint and steel or a fire charge, and mineshafts, dungeons and shipwrecks still keep iron."
				""
				"Once lit, it burns all its fuel, work or no work, so load it when you mean it. A shovel puts it out and keeps the fuel."
				""
				"Heat from the block underneath needs no lighting."
			]
			id: "380C39E07B5A7809"
			rewards: [ ]
			subtitle: "Fuel waits for a flame"
			tasks: [
				{
					icon: "minecraft:flint_and_steel"
					id: "56F5E09C159A870B"
					observe_type: 2
					timer: 10L
					title: "Look at a lit Furnace"
					to_observe: "mcremix:kiln[lit=true]"
					type: "observation"
				}
			]
			title: "Light It"
			x: 5.25d
			y: 1.75d
		}
		{
			dependencies: [
				"6C06A8D2FE2265D4"
			]
			description: [
				"Every fire sits on one scale: &eWarm&r, &6Hot&r, &cSearing&r, &bBlazing&r. Each recipe has a minimum, and every level above it halves the time."
				""
				"Wood burns &eWarm&r, as does a campfire or magma block under the Furnace: enough to char logs and fire clay into bricks and terracotta. A Furnace on a campfire stays &eWarm&r forever, for free."
				""
				"&7JEI: the Furnace tab gives each firing's heat, and the Furnace Heat tab shows what burns how hot.&r"
			]
			id: "466E58C303880A27"
			rewards: [ ]
			subtitle: "One scale for every fire"
			tasks: [
				{
					id: "5CBE8993824B8BDB"
					item: "minecraft:charcoal"
					type: "item"
				}
			]
			title: "Warm: Charcoal"
			x: 5.25d
			y: 0.0d
		}
		{
			dependencies: [
				"466E58C303880A27"
				"380C39E07B5A7809"
			]
			description: [
				"Charcoal and coal burn &6Hot&r, as does fire or lava under the Furnace. That covers vanilla's smelting that isn't food: glass, smooth stone, copper, gold. Raw iron, iron ore and ancient debris want hotter fires of their own."
				""
				"Copper is your first real metal, for Create's parts and the first tier of your own."
			]
			id: "690A67A6D21199B1"
			rewards: [ ]
			subtitle: "Charcoal and coal burn Hot"
