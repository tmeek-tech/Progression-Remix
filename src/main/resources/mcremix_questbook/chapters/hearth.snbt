		}
		{
			dependencies: [
				"690A67A6D21199B1"
			]
			description: [
				"Fire coal at &6Hot&r and it cokes into Coal Coke, which burns &cSearing&r and lasts twice as long."
				""
				"Coking also leaves coal tar in a tank inside the Furnace. Past a bucket it burns off at the chimney, so ignore it for now. Later, that black goo is one of the most useful things you make."
			]
			id: "35D075A91FFA3F0D"
